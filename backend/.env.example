# Copia este archivo como  .env  y ajusta los valores.

# Conexión a PostgreSQL:  postgresql+psycopg2://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Usa el mismo usuario y contraseña con los que entras a pgAdmin.
DATABASE_URL=postgresql+psycopg2://postgres:TU_CONTRASEÑA@localhost:5432/parkmatch

# Clave para firmar los tokens JWT. Cámbiala por un texto largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Duración de la sesión, en minutos.
TOKEN_MINUTOS=480

# Origen del frontend permitido (Vite usa el puerto 5173).
ORIGENES_CORS=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria en la que se interpretan el calendario y las tarifas.
ZONA_HORARIA=America/Lima
